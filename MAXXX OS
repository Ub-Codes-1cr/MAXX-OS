### 5.3 The `golden_lint.py` Validator

Before any draft reaches the UI, it must pass the linter. This is a deterministic Python script, not an LLM guess.

````python
import re

def golden_lint(platform: str, draft: str, division: str) -> dict:
    errors = []

    # Rule 1 & 2: X (Twitter) Constraints
    if platform == "x":
        if len(draft) > 280:
            errors.append(f"FAIL: X draft is {len(draft)} chars. Max is 280.")
        if division == "Tech" and "http" in draft.split('\n')[0]:
            errors.append("FAIL: Tech Division rule: No raw links in the first X tweet.")

    # Rule 3 & 4: LinkedIn Constraints
    elif platform == "linkedin":
        if len(draft) < 800 or len(draft) > 1200:
            errors.append(f"FAIL: LinkedIn draft is {len(draft)} chars. Must be 800-1200.")
        if draft.count('\n\n') < 3:
            errors.append("FAIL: LinkedIn requires at least 3 double-spaced line breaks for readability.")

    # Rule 7 & 8: Dev.to Constraints
    elif platform == "devto":
        if not re.search(r'##\s', draft):
            errors.append("FAIL: Dev.to requires at least one H2 (##) heading.")
        if division == "Tech" and "```" not in draft:
            errors.append("FAIL: Tech Division rule: Dev.to posts must include a code block.")

    # Global Anti-Word Filter (Rule 31)
    banned_words = ["game-changer", "revolutionary", "synergy", "unleash"]
    for word in banned_words:
        if word.lower() in draft.lower():
            errors.append(f"FAIL: Banned anti-word detected: '{word}'.")

    return {
        "platform": platform,
        "passed": len(errors) == 0,
        "errors": errors,
        "draft": draft
    }
````

_If `passed` is False, the LangChain agent is triggered again with the error messages appended to the prompt: "Your previous draft failed validation. Fix these errors: [errors]."_

